#!/bin/bash
#
# Pre-commit hook: ajaa kaikki yksikkö- ja API-testit ennen committia.
# Tarkoitus: estää rikkinäisen koodin pääsy historiaan.
#
# Käyttöönotto kerran: git config core.hooksPath .githooks
# Ohitus tarvittaessa: git commit --no-verify
#

set -e

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

echo "→ Backend: pytest unit + api"
uv run pytest tests/unit tests/api -q --no-header

echo ""
echo "→ Frontend: vitest"
cd frontend
npm test --silent

echo ""
echo "✓ Kaikki testit OK"
